# Flask Configuration
SECRET_KEY=medicore_v1_dev_secret
JWT_SECRET_KEY=medicore_jwt_dev_secret
FLASK_DEBUG=true

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///medicore.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Google Chat Webhook (Optional)
GOOGLE_CHAT_WEBHOOK_URL=

# Email Configuration (for monthly reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google Calendar Configuration (ACTIVE - Required for appointment reminders)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
REMINDER_HOURS_BEFORE=3

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
